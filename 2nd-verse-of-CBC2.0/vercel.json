{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/meals",
      "destination": "/meals.html"
    },
    {
      "source": "/attendance",
      "destination": "/attendance.html"
    },
    {
      "source": "/assistant",
      "destination": "/assistant/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{node_modules,public,dist,src,.git}/**"
    }
  }
}
