{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/meals",
      "destination": "/meals.html"
    },
    {
      "source": "/attendance",
      "destination": "/attendance.html"
    },
    {
      "source": "/assistant",
      "destination": "/assistant/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{node_modules,public,dist,src,.git}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|svg|webp|woff2|pdf|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
